# PayPal sandbox app credentials (https://developer.paypal.com/dashboard > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Gemini API key (https://aistudio.google.com/apikey - free tier works)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_OWNER_EMAIL=

# Keep execution OFF for this read-only fictional preview.
PROOF_PAYMENTS_ENABLED=false
# Optional: canonical public site URL for metadata, sitemap, robots.txt and structured data (no trailing slash).
# Defaults to https://automatepal.onrender.com. Set to https://automatepal.com once that domain serves the app,
# and update the two URLs in public/.well-known/security.txt at the same time.
NEXT_PUBLIC_SITE_URL=

# Answers and grounding checks use Claude when this is set (otherwise Gemini). Embeddings always use Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: force anthropic|gemini, and the per-process daily model spend ceiling in USD (default 1.00).
LLM_PROVIDER=
LLM_DAILY_USD_CAP=1.00
# Context.dev API key: optional fallback renderer for JavaScript-only pages in the website crawler (max 10 per crawl).
CONTEXT_DEV_API_KEY=
# Billing support (read-only provider lookups). Server-only. Credentials owners connect are encrypted per workspace.
# Encryption keys: comma-separated kid:base64 (32 bytes each), e.g. k1:$(openssl rand -base64 32). Add k2 and switch the active id to rotate.
BILLING_ENCRYPTION_KEYS=
BILLING_ENCRYPTION_ACTIVE_KID=k1
# Server proof for ciphertext RPCs (openssl rand -hex 32). Separate from the encryption keys so rotation does not change it.
BILLING_RPC_SECRET=
# Live-check only (npm run billing:live-check -- <provider>), TEST/sandbox keys. Not used by the app at runtime.
# PayPal uses PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET above.
STRIPE_TEST_RESTRICTED_KEY=
DODO_TEST_API_KEY=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
PADDLE_SANDBOX_API_KEY=
SQUARE_SANDBOX_ACCESS_TOKEN=
ADYEN_TEST_API_KEY=
ADYEN_TEST_MERCHANT_ACCOUNT=
MOLLIE_TEST_API_KEY=
CHARGEBEE_TEST_SITE=
CHARGEBEE_TEST_API_KEY=
LEMONSQUEEZY_TEST_API_KEY=
# Optional: a sandbox order/invoice reference and its payer email for the live check's verify step.
BILLING_LIVE_CHECK_REFERENCE=
BILLING_LIVE_CHECK_EMAIL=
# Deployment mode: preview (default) or production. Production removes the "fictional data only" wording;
# payment execution and billing writes stay off in both modes. Set it before the build (client pages read it).
APP_MODE=preview
# Public origin used in emails and invite links (no trailing slash), e.g. https://automatepal.onrender.com
APP_URL=
# Server-only Supabase service role key for scheduled jobs, owner alert emails and server-error rows.
# Never expose it to the browser. Without it those jobs are skipped.
SUPABASE_SERVICE_ROLE_KEY=
# Email via Resend (https://resend.com). Transport is OFF unless the key is set: every email is a recorded dry run.
RESEND_API_KEY=
EMAIL_FROM=AutomatePal <hello@automatepal.com>
# Optional: where replies go when the sender address has no mailbox (a bare address).
EMAIL_REPLY_TO=raviteja@automatepal.com
# Bearer secret for POST /api/cron/refresh (openssl rand -hex 32). Same value as the GitHub secret CRON_SECRET.
CRON_SECRET=
# Optional https webhook (Slack/Discord-style) that gets one POST on a burst of server errors.
ALERT_WEBHOOK_URL=

# Signs the permission for a customer's website to frame the /help chat panel (lib/widget-frame.ts).
# 32+ random characters. Required in production: without it the widget panel only opens on this app's own
# pages. Rotating it ends current frame grants; visitors' widgets fetch fresh ones on their next page load.
WIDGET_FRAME_SECRET=

# AutomatePal's own plans (Phase 2, lib/plans.ts). PAYPAL_WEBHOOK_ID: the id of the webhook you create in the
# PayPal developer dashboard for https://<your app>/api/paypal/webhook (events: Billing subscription *, Payment
# sale *). Without it the webhook answers 503. PAYPAL_PLAN_IDS: optional JSON with six P-… ids
# (starter_month, starter_year, growth_month, growth_year, scale_month, scale_year); defaults to the sandbox plans.
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_IDS=

# Deep answers (Phase 3, Widget studio "Answer model: Deep", paid plans): the larger model for the answer step.
# Defaults: claude-sonnet-5-5 with Anthropic, GEMINI_MODEL with Gemini.
ANTHROPIC_DEEP_MODEL=
GEMINI_DEEP_MODEL=

# Push notifications to the team's devices (Phase 3, mobile inbox). Generate a pair with
#   node scripts/generate-vapid-keys.mjs
# Keep the private key secret (wrangler secret put WEB_PUSH_PRIVATE_KEY). Without them the card says push is not set up.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@automatepal.com
