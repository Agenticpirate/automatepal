// Cloudflare Workers deploy for automatepal.com (OpenNext). Deploy: `npm run cf:deploy` after `wrangler login`.
// Secrets are NOT here: set them with `npx wrangler secret put NAME` (see .env.example for the list:
// ANTHROPIC_API_KEY, GEMINI_API_KEY, CONTEXT_DEV_API_KEY, PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET,
// BILLING_ENCRYPTION_KEYS, BILLING_RPC_SECRET, SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET, RESEND_API_KEY).
// automatepal.com and www are attached to this Worker as custom domains in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automatepal-web",
  "account_id": "413ece1ed1ad020ce7e952549cd0095a",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "automatepal-web" }],
  "observability": { "enabled": true },
  // Hourly scheduled jobs (custom-worker.ts -> POST /api/cron/refresh). Needs the CRON_SECRET secret.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "APP_PLATFORM": "cloudflare",
    "APP_MODE": "preview",
    "APP_URL": "https://automatepal.com",
    "NEXT_PUBLIC_SITE_URL": "https://automatepal.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://sknmlhjaysqmtyeqpfiv.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_IAnoAW22YFrqFYFTEP59wg_Ko_ywlsi",
    "PROOF_PAYMENTS_ENABLED": "false",
    "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    "LLM_DAILY_USD_CAP": "1.00",
    "BILLING_ENCRYPTION_ACTIVE_KID": "k1",
    "EMAIL_FROM": "AutomatePal <hello@automatepal.com>",
    "EMAIL_REPLY_TO": "raviteja@automatepal.com"
  }
  ,
  // Staging: `npm run cf:deploy:staging`. Uses its own Supabase project; set its secrets with
  // `npx wrangler secret put NAME --env staging`. NEXT_PUBLIC_* values are also inlined at build time,
  // so the staging build must run with the staging NEXT_PUBLIC_SUPABASE_URL / ANON_KEY in its environment.
  "env": {
    "staging": {
      "name": "automatepal-web-staging",
      "routes": [{ "pattern": "staging.automatepal.com", "custom_domain": true }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "automatepal-web-staging" }],
      "triggers": { "crons": ["47 * * * *"] },
      "vars": {
        "APP_PLATFORM": "cloudflare",
        "APP_MODE": "preview",
        "APP_URL": "https://staging.automatepal.com",
        "NEXT_PUBLIC_SITE_URL": "https://staging.automatepal.com",
        "NEXT_PUBLIC_SUPABASE_URL": "SET_STAGING_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "SET_STAGING_SUPABASE_PUBLISHABLE_KEY",
        "PROOF_PAYMENTS_ENABLED": "false",
        "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
        "ANTHROPIC_MODEL": "claude-haiku-5-5",
        "LLM_DAILY_USD_CAP": "1.00",
        "BILLING_ENCRYPTION_ACTIVE_KID": "k1",
        "EMAIL_FROM": "AutomatePal Staging <hello@automatepal.com>",
        "EMAIL_REPLY_TO": "raviteja@automatepal.com"
      }
    }
  }
}
